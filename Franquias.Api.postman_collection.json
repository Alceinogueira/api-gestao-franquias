{
  "info": {
    "name": "Sistema de Gestao de Franquias",
    "description": "Colecao de testes da API REST do trabalho de Desenvolvimento Back-end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@franquias.com\",\n  \"senha\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login (operador)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operador.centro@franquias.com\",\n  \"senha\": \"Operador@123\"\n}"
            }
          }
        },
        {
          "name": "Cadastrar usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "auth", "usuarios"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Operador\",\n  \"email\": \"novo.operador@franquias.com\",\n  \"senha\": \"Senha@123\",\n  \"perfil\": 3,\n  \"unidadeFranqueadaId\": 1\n}"
            }
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "auth", "usuarios"] }
          }
        }
      ]
    },
